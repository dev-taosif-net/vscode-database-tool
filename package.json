{
  "name": "db-lite",
  "displayName": "DB Lite",
  "description": "Super fast, lightweight SQL client for PostgreSQL and Microsoft SQL Server. Write SQL with built-in function suggestions, execute, and view results instantly. Connections stored securely in the OS keychain.",
  "version": "0.8.0",
  "publisher": "taosif",
  "license": "MIT",
  "author": "Taosif",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "sql",
    "postgres",
    "postgresql",
    "mssql",
    "sql server",
    "database"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dbtool.addConnection",
        "title": "Add Connection",
        "category": "DB Lite",
        "icon": "$(add)"
      },
      {
        "command": "dbtool.connect",
        "title": "Connect",
        "category": "DB Lite",
        "icon": "$(plug)"
      },
      {
        "command": "dbtool.disconnect",
        "title": "Disconnect",
        "category": "DB Lite",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "dbtool.editConnection",
        "title": "Edit Connection",
        "category": "DB Lite",
        "icon": "$(edit)"
      },
      {
        "command": "dbtool.removeConnection",
        "title": "Remove Connection",
        "category": "DB Lite",
        "icon": "$(trash)"
      },
      {
        "command": "dbtool.newQuery",
        "title": "New SQL Query",
        "category": "DB Lite",
        "icon": "$(new-file)"
      },
      {
        "command": "dbtool.tabConnection",
        "title": "Use Connection for This Tab…",
        "category": "DB Lite",
        "icon": "$(database)"
      },
      {
        "command": "dbtool.runQuery",
        "title": "Run Query",
        "category": "DB Lite",
        "icon": "$(play)"
      },
      {
        "command": "dbtool.explainQuery",
        "title": "Run with Execution Plan",
        "category": "DB Lite",
        "icon": "$(pulse)"
      },
      {
        "command": "dbtool.queryBuilder",
        "title": "Open Query Builder",
        "category": "DB Lite",
        "icon": "$(circuit-board)"
      },
      {
        "command": "dbtool.searchObjects",
        "title": "Search Tables & Procedures",
        "category": "DB Lite",
        "icon": "$(search)"
      },
      {
        "command": "dbtool.peekTable",
        "title": "Show First 100 Rows",
        "category": "DB Lite",
        "icon": "$(eye)"
      },
      {
        "command": "dbtool.viewRoutine",
        "title": "View Definition",
        "category": "DB Lite",
        "icon": "$(code)"
      },
      {
        "command": "dbtool.execRoutine",
        "title": "Generate EXEC Template",
        "category": "DB Lite",
        "icon": "$(run)"
      },
      {
        "command": "dbtool.createObject",
        "title": "Create New Object (Table, View, SP…)",
        "category": "DB Lite",
        "icon": "$(file-add)"
      },
      {
        "command": "dbtool.switchDatabase",
        "title": "Switch Database",
        "category": "DB Lite",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "dbtool.countRows",
        "title": "Count Rows",
        "category": "DB Lite",
        "icon": "$(symbol-number)"
      },
      {
        "command": "dbtool.scriptSelect",
        "title": "Script as SELECT",
        "category": "DB Lite"
      },
      {
        "command": "dbtool.scriptInsert",
        "title": "Script as INSERT",
        "category": "DB Lite"
      },
      {
        "command": "dbtool.scriptUpdate",
        "title": "Script as UPDATE",
        "category": "DB Lite"
      },
      {
        "command": "dbtool.scriptDelete",
        "title": "Script as DELETE",
        "category": "DB Lite"
      },
      {
        "command": "dbtool.scriptCreate",
        "title": "Script as CREATE",
        "category": "DB Lite"
      },
      {
        "command": "dbtool.truncateTable",
        "title": "Truncate Table…",
        "category": "DB Lite",
        "icon": "$(warning)"
      },
      {
        "command": "dbtool.deleteRows",
        "title": "Delete All Rows…",
        "category": "DB Lite",
        "icon": "$(warning)"
      },
      {
        "command": "dbtool.dropObject",
        "title": "Drop Table/View…",
        "category": "DB Lite",
        "icon": "$(trash)"
      },
      {
        "command": "dbtool.dropRoutine",
        "title": "Drop Procedure/Function…",
        "category": "DB Lite",
        "icon": "$(trash)"
      },
      {
        "command": "dbtool.clearAllData",
        "title": "Clear All Data (Connections & Credentials)",
        "category": "DB Lite",
        "icon": "$(clear-all)"
      },
      {
        "command": "dbtool.refreshSchema",
        "title": "Refresh Schema (completion metadata)",
        "category": "DB Lite",
        "icon": "$(refresh)"
      },
      {
        "command": "dbtool.showLogs",
        "title": "Show Logs",
        "category": "DB Lite",
        "icon": "$(output)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbLite",
          "title": "DB Lite",
          "icon": "media/database.svg"
        }
      ],
      "panel": [
        {
          "id": "dbLiteResults",
          "title": "Query Results",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbLite": [
        {
          "id": "dbtool.connections",
          "name": "Connections",
          "icon": "media/database.svg"
        }
      ],
      "dbLiteResults": [
        {
          "id": "dbtool.resultsView",
          "name": "Results",
          "type": "webview",
          "icon": "media/database.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbtool.connections",
        "contents": "No database connections yet.\n[Add Connection](command:dbtool.addConnection)\nConnect to PostgreSQL or SQL Server with individual fields or a connection string. Credentials are stored in your OS keychain."
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dbtool.addConnection",
          "when": "view == dbtool.connections",
          "group": "navigation@1"
        },
        {
          "command": "dbtool.newQuery",
          "when": "view == dbtool.connections",
          "group": "navigation@2"
        },
        {
          "command": "dbtool.queryBuilder",
          "when": "view == dbtool.connections",
          "group": "navigation@3"
        },
        {
          "command": "dbtool.disconnect",
          "when": "view == dbtool.connections",
          "group": "1_actions@1"
        },
        {
          "command": "dbtool.refreshSchema",
          "when": "view == dbtool.connections",
          "group": "1_actions@2"
        },
        {
          "command": "dbtool.createObject",
          "when": "view == dbtool.connections",
          "group": "1_actions@3"
        },
        {
          "command": "dbtool.switchDatabase",
          "when": "view == dbtool.connections",
          "group": "1_actions@4"
        },
        {
          "command": "dbtool.showLogs",
          "when": "view == dbtool.connections",
          "group": "1_actions@5"
        },
        {
          "command": "dbtool.clearAllData",
          "when": "view == dbtool.connections",
          "group": "9_danger@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dbtool.connect",
          "when": "view == dbtool.connections && viewItem =~ /connection/",
          "group": "inline@1"
        },
        {
          "command": "dbtool.connect",
          "when": "view == dbtool.connections && viewItem =~ /connection/",
          "group": "1_actions@1"
        },
        {
          "command": "dbtool.newQuery",
          "when": "view == dbtool.connections && viewItem =~ /connection/",
          "group": "1_actions@2"
        },
        {
          "command": "dbtool.editConnection",
          "when": "view == dbtool.connections && viewItem =~ /connection/",
          "group": "2_manage@1"
        },
        {
          "command": "dbtool.removeConnection",
          "when": "view == dbtool.connections && viewItem =~ /connection/",
          "group": "2_manage@2"
        },
        {
          "command": "dbtool.switchDatabase",
          "when": "view == dbtool.connections && viewItem == database",
          "group": "inline@1"
        },
        {
          "command": "dbtool.switchDatabase",
          "when": "view == dbtool.connections && viewItem == database",
          "group": "1_actions@1"
        },
        {
          "command": "dbtool.newQuery",
          "when": "view == dbtool.connections && viewItem =~ /database/",
          "group": "1_actions@2"
        },
        {
          "command": "dbtool.refreshSchema",
          "when": "view == dbtool.connections && viewItem == databaseCurrent",
          "group": "1_actions@3"
        },
        {
          "command": "dbtool.peekTable",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "inline@1"
        },
        {
          "command": "dbtool.peekTable",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "1_actions@1"
        },
        {
          "command": "dbtool.countRows",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "1_actions@2"
        },
        {
          "command": "dbtool.scriptSelect",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "2_script@1"
        },
        {
          "command": "dbtool.scriptInsert",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "2_script@2"
        },
        {
          "command": "dbtool.scriptUpdate",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "2_script@3"
        },
        {
          "command": "dbtool.scriptDelete",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "2_script@4"
        },
        {
          "command": "dbtool.scriptCreate",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "2_script@5"
        },
        {
          "command": "dbtool.deleteRows",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "9_danger@1"
        },
        {
          "command": "dbtool.truncateTable",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "9_danger@2"
        },
        {
          "command": "dbtool.dropObject",
          "when": "view == dbtool.connections && viewItem == table",
          "group": "9_danger@3"
        },
        {
          "command": "dbtool.viewRoutine",
          "when": "view == dbtool.connections && viewItem == routine",
          "group": "1_actions@1"
        },
        {
          "command": "dbtool.execRoutine",
          "when": "view == dbtool.connections && viewItem == routine",
          "group": "1_actions@2"
        },
        {
          "command": "dbtool.dropRoutine",
          "when": "view == dbtool.connections && viewItem == routine",
          "group": "9_danger@1"
        }
      ],
      "editor/title": [
        {
          "command": "dbtool.runQuery",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "dbtool.explainQuery",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dbtool.runQuery",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == 'sql'"
      },
      {
        "command": "dbtool.explainQuery",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && editorLangId == 'sql'"
      },
      {
        "command": "dbtool.newQuery",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      },
      {
        "command": "dbtool.searchObjects",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "dbtool.queryBuilder",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      }
    ],
    "configuration": {
      "title": "DB Lite",
      "properties": {
        "dbtool.theme": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "Follow your VS Code color theme",
            "Always dark",
            "Always light"
          ],
          "default": "default",
          "description": "Color theme for DB Lite panels (query results and the connection editor)."
        },
        "dbtool.connectionFooter": {
      "type": "boolean",
      "default": true,
      "description": "Show a footer bar at the end of every SQL script with the tab's connection (name, user, database), filled with that connection's environment color."
    },
    "dbtool.autoUppercaseKeywords": {
          "type": "boolean",
          "default": true,
          "description": "Automatically UPPERCASE SQL keywords as you type (select → SELECT)."
        },
        "dbtool.autoAlias": {
          "type": "boolean",
          "default": true,
          "description": "Insert a table alias together with table completions after FROM/JOIN (empEmployeeBasicInfo → eebi), and suggest aliases after manually typed table names."
        },
        "dbtool.schemaCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Load table/column/foreign-key metadata after connecting and use it for context-aware completions (tables after FROM/JOIN, columns after an alias + dot, …)."
        },
        "dbtool.smartJoins": {
          "type": "boolean",
          "default": true,
          "description": "Auto-generate JOIN clauses from foreign keys: after JOIN, suggest the full \"table alias ON alias.fk = other.pk\"; after ON, suggest the matching condition."
        },
        "dbtool.semanticHighlighting": {
          "type": "boolean",
          "default": true,
          "description": "Color known schema objects in SQL files: tables, columns, aliases, schemas, and functions/procedures each get their own theme color."
        },
        "dbtool.resultsLocation": {
          "type": "string",
          "enum": [
            "panel",
            "terminal",
            "grid"
          ],
          "enumDescriptions": [
            "SSMS-style grid in the bottom panel next to the terminal (yellow NULL cells, horizontal scroll, aggregates, copy as TSV)",
            "Plain text in a \"Query Results\" terminal (NULLs highlighted)",
            "Interactive grid in a webview editor tab"
          ],
          "default": "panel",
          "description": "Where query results are shown. Execution plans always open in the webview tab."
        },
        "dbtool.maxRenderRows": {
          "type": "number",
          "default": 1000,
          "minimum": 50,
          "description": "Maximum number of rows rendered per result set in the results panel (all rows are fetched; rendering is capped to keep the panel fast)."
        },
        "dbtool.clearAllDataHint": {
          "type": "null",
          "default": null,
          "markdownDescription": "To delete every saved connection and credential, run the **DB Lite: Clear All Data (Connections & Credentials)** command from the Command Palette (settings pages cannot host buttons)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.mjs",
    "build": "node esbuild.mjs",
    "build:dev": "node esbuild.mjs --dev",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --allow-missing-repository"
  },
  "dependencies": {
    "mssql": "^11.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.10",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  }
}
